# Editor defaults, so a contributor's editor does not fight the repository.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Dart's own convention, enforced by `dart format`.
[*.dart]
max_line_length = 80

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts,gradle}]
indent_size = 4

[*.swift]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown, so trimming them
# silently changes rendering.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
